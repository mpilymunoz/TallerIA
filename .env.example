# Puerto donde se abre el chatbot (http://localhost:3000)
PORT=3000

# Tipo de base de datos: json | sqlite | mongodb
#  - json:    guarda todo en un archivo (no requiere instalar nada)
#  - sqlite:  base de datos SQLite en un archivo (incluida en Node 22+)
#  - mongodb: servidor MongoDB local o en la nube (Atlas)
DB_TYPE=json

# Ruta del archivo para json / sqlite
DB_FILE=./data/robots.json
# DB_FILE=./data/robots.sqlite

# Sólo para MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=taller_ia

# Clave del docente para borrar robots
DOCENTE_PIN=1234

# Qué tan parecida debe ser una pregunta para que el robot responda (0 a 1)
UMBRAL_COINCIDENCIA=0.4
